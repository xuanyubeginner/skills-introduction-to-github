%% Compact one-page CV (classic finance look), rebuilt for ATS parsing.
%% Same Jinja syntax as cv.tex.j2:  \VAR{...} values, \BLOCK{...} logic,
%%   |e escapes LaTeX, |md escapes and turns **text** into bold.
%% ATS changes compared with a typical tabular/icon template:
%%   - no tabular/tabularx for entries (dates via \hfill) -> text extracts in reading order
%%   - no icon fonts (fontawesome) -> contact details are plain text a parser can find
%%   - glyphtounicode + cmap + no f-ligatures -> "financial" is extracted as "financial"
%%   - standard headings: Profile, Key Skills, Professional Experience, Education
%% Section order comes from cv.section_order (default below); `tailor --education-first`
%% swaps Experience and Education for graduate programmes / internships.
%%   - photo is optional (cv.photo); it is an image, so it never hides text
\documentclass[a4paper,10pt]{article}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{lmodern}
\usepackage{cmap}
\input{glyphtounicode}\pdfgentounicode=1
\usepackage[expansion=false,protrusion=false]{microtype}
\DisableLigatures[f]{encoding=*, family=*}
%% Layout knobs. `tailor --pdf` searches these so the CV fills exactly one page (see jobhunter/fit.py).
\BLOCK{ set f = fit or dict() }
\usepackage[left=\VAR{f.ml or 1.4}cm,top=\VAR{f.mv or 1.0}cm,right=\VAR{f.mr or 1.2}cm,bottom=\VAR{f.mv or 1.0}cm]{geometry}
\newcommand{\bodyfont}{\fontsize{\VAR{f.fs or 9}}{\VAR{f.bs or 11}}\selectfont}
\newcommand{\metafont}{\fontsize{\VAR{f.ms or 8}}{\VAR{f.mbs or 9.5}}\selectfont}
\newcommand{\fitsp}[1]{\vspace{\VAR{f.sp or 1}\dimexpr #1\relax}}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{graphicx}
\usepackage[hidelinks]{hyperref}
\urlstyle{same}

\pagestyle{empty}
\raggedright
\setlength{\parindent}{0pt}
\titleformat{\section}{\vspace{-4pt}\scshape\raggedright\large\bfseries}{}{0em}{}[\titlerule\vspace{-2pt}]
\titlespacing*{\section}{0pt}{\VAR{(7 * (f.sp or 1))|round(2)}pt}{\VAR{(4 * (f.sp or 1))|round(2)}pt}
\renewcommand{\labelitemi}{\raisebox{0.2ex}{\tiny$\bullet$}}
\setlist[itemize]{leftmargin=3.2ex,rightmargin=1.5ex,labelsep=1.2mm,itemsep=\VAR{(0.4 * (f.sp or 1))|round(3)}mm,topsep=\VAR{(0.4 * (f.sp or 1))|round(3)}mm,parsep=0pt}

%% {Title}{Date}{Organisation}{Location}: title + date on line 1, organisation + location on line 2
\newcommand{\entry}[4]{\textbf{#1}\hfill\textbf{\metafont #2}\\{\metafont #3}\hfill{\metafont #4}\par\fitsp{0.3mm}}

\hypersetup{pdftitle={\VAR{cv.name|e} - CV}, pdfauthor={\VAR{cv.name|e}}, pdfkeywords={\VAR{keywords|join(', ')|e}}}



%%---------- Sections (macros so the order is configurable) ----------
\BLOCK{ macro profile_section() }
\BLOCK{ if cv.summary }
\section{Profile}
{\bodyfont \VAR{cv.summary|md}\par}
\BLOCK{ endif }
\BLOCK{ endmacro }

\BLOCK{ macro skills_section(title) }
\section{\VAR{title}}
\begin{itemize}[leftmargin=0pt,label={},itemsep=\VAR{(0.6 * (f.sp or 1))|round(3)}mm]\bodyfont
\BLOCK{ for group, items in cv.skills.items() }
  \item \textbf{\VAR{group|e}:} \VAR{items|join(', ')|e}
\BLOCK{ endfor }
\BLOCK{ if cv.languages }
  \item \textbf{Languages:} \BLOCK{ for l in cv.languages }\VAR{l.name|e} (\VAR{l.level|e})\BLOCK{ if not loop.last }, \BLOCK{ endif }\BLOCK{ endfor }

\BLOCK{ endif }
\BLOCK{ if cv.certifications }
  \item \textbf{Certification\BLOCK{ if cv.certifications|length > 1 }s\BLOCK{ endif }:} \VAR{cv.certifications|join('; ')|e}
\BLOCK{ endif }
\end{itemize}
\BLOCK{ endmacro }

\BLOCK{ macro experience_section() }
\section{Professional Experience}
\BLOCK{ for x in cv.experience }
\entry{\VAR{x.title|e}}{\VAR{x.start|e} -- \VAR{x.end|e}}{\VAR{x.company|e}}{\VAR{x.location|e}}
\begin{itemize}\bodyfont
\BLOCK{ for b in x.bullets }  \item \VAR{b|md}
\BLOCK{ endfor }\end{itemize}
\fitsp{0.5mm}
\BLOCK{ endfor }
\BLOCK{ endmacro }

\BLOCK{ macro education_section() }
\section{Education}
\BLOCK{ for ed in cv.education }
\entry{\VAR{ed.degree|e}}{\VAR{ed.start|e} -- \VAR{ed.end|e}}{\VAR{ed.school|e}}{\VAR{ed.location|e}}
\BLOCK{ if ed.bullets or ed.details }
\begin{itemize}\bodyfont
\BLOCK{ if ed.details }  \item \VAR{ed.details|md}
\BLOCK{ endif }\BLOCK{ for b in ed.bullets }  \item \VAR{b|md}
\BLOCK{ endfor }\end{itemize}
\BLOCK{ endif }
\fitsp{0.5mm}
\BLOCK{ endfor }
\BLOCK{ endmacro }

\BLOCK{ macro projects_section() }
\BLOCK{ if cv.projects }
\section{Projects}
\BLOCK{ for p in cv.projects }
\textbf{\VAR{p.name|e}}\BLOCK{ if p.tech } -- {\metafont \VAR{p.tech|join(', ')|e}}\BLOCK{ endif }\par
\begin{itemize}\bodyfont
\BLOCK{ for b in p.bullets }  \item \VAR{b|md}
\BLOCK{ endfor }\end{itemize}
\BLOCK{ endfor }
\BLOCK{ endif }
\BLOCK{ endmacro }

\begin{document}

%%---------- Heading ----------
%% Labelled contact + personal items packed on as few lines as possible. Items never
%% split; when a line is full the next item moves down and the "|" at the break
%% disappears (\discretionary).
%% With a photo: name aligned with the photo's top edge, contact lines with its bottom edge.
\BLOCK{ set order = cv.section_order or ['profile', 'skills', 'experience', 'education', 'projects'] }
\BLOCK{ set sep = '\\discretionary{}{}{\\kern0.5em\\textbar\\kern0.5em}' }
\BLOCK{ set items = ['\\mbox{Tel: ' ~ (cv.contact.phone|e) ~ '}',
                     '\\mbox{Email: \\href{mailto:' ~ cv.contact.email ~ '}{' ~ (cv.contact.email|e) ~ '}}',
                     '\\mbox{Address: ' ~ (cv.contact.location|e) ~ '}'] }
\BLOCK{ if cv.contact.linkedin }\BLOCK{ set _ = items.append('\\mbox{LinkedIn: \\href{https://' ~ cv.contact.linkedin ~ '}{' ~ (cv.contact.linkedin|e) ~ '}}') }\BLOCK{ endif }
\BLOCK{ if cv.contact.github }\BLOCK{ set _ = items.append('\\mbox{GitHub: \\href{https://' ~ cv.contact.github ~ '}{' ~ (cv.contact.github|e) ~ '}}') }\BLOCK{ endif }
\BLOCK{ set personal = [] }
\BLOCK{ if cv.contact.birth_date }\BLOCK{ set _ = personal.append('\\mbox{Date of birth: ' ~ (cv.contact.birth_date|e) ~ '}') }\BLOCK{ endif }
\BLOCK{ if cv.contact.nationality }\BLOCK{ set _ = personal.append('\\mbox{Nationality: ' ~ (cv.contact.nationality|e) ~ '}') }\BLOCK{ endif }
\BLOCK{ if cv.contact.work_permit }\BLOCK{ set _ = personal.append('\\mbox{' ~ (cv.contact.work_permit|e) ~ '}') }\BLOCK{ endif }
\BLOCK{ macro contact_lines() }{\bodyfont\raggedright \VAR{(items + personal)|join(sep)}\par}\BLOCK{ endmacro }
\BLOCK{ if cv.photo }
\begin{minipage}[t][\VAR{cv.photo_height or 2.6}cm][t]{\dimexpr\linewidth-3.0cm\relax}\vspace{0pt}
{\fontsize{24}{28}\selectfont\bfseries \VAR{cv.name|e}\par}
\BLOCK{ if cv.headline }\vspace{3pt}{\normalsize \VAR{cv.headline|e}\par}\BLOCK{ endif }
\vfill
\VAR{ contact_lines() }
\end{minipage}\hfill\begin{minipage}[t]{2.8cm}\vspace{0pt}\raggedleft\includegraphics[height=\VAR{cv.photo_height or 2.6}cm,width=2.8cm,keepaspectratio]{\VAR{cv.photo}}\end{minipage}
\BLOCK{ else }
{\fontsize{24}{28}\selectfont\bfseries \VAR{cv.name|e}\par}\vspace{6pt}
\BLOCK{ if cv.headline }{\normalsize \VAR{cv.headline|e}\par}\vspace{3pt}\BLOCK{ endif }
\VAR{ contact_lines() }
\BLOCK{ endif }
\par\fitsp{1mm}

\BLOCK{ for s in order }
\BLOCK{ if s == 'profile' }\VAR{ profile_section() }
\BLOCK{ elif s == 'skills' }\VAR{ skills_section('Key Skills' if loop.index0 > 0 and order[loop.index0 - 1] == 'profile' else 'Skills') }
\BLOCK{ elif s == 'experience' }\VAR{ experience_section() }
\BLOCK{ elif s == 'education' }\VAR{ education_section() }
\BLOCK{ elif s == 'projects' }\VAR{ projects_section() }
\BLOCK{ endif }
\BLOCK{ endfor }

\par\typeout{JOBHUNTER-FILL \the\pagetotal\space\the\pagegoal}
\end{document}
